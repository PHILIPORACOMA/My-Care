APP_NAME="My Care API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# All timestamps are stored in UTC. Conversion to Asia/Manila happens at
# display time only — devices may be offline for weeks, and drifting
# timezones corrupt trend charts and the cluster-detection banner.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 only. There is no sqlite connection defined in config/database.php.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mycare
DB_USERNAME=root
DB_PASSWORD=

# File/sync/array drivers keep the schema to exactly the 20 Data Dictionary
# entities — no cache, jobs, or sessions tables are created.
# Staff auth is Sanctum in SPA (cookie) mode, so sessions carry the login.
# The file driver is deliberate: a database driver would add a `sessions`
# table and break the 20-entity Data Dictionary. See ADR-0004.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# In production set this to the shared parent domain so the cookie is valid
# for both the API and the SPAs, e.g. .mycare.example. Cookie auth REQUIRES
# the portal/console and the API to share a registrable domain.
SESSION_DOMAIN=null

# Origins Sanctum treats as first-party and gives a session to. A request
# whose Origin/Referer is not listed here gets no session, and staff login
# answers 400 rather than silently failing. Comma-separated, no scheme.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000

# The SPA origins allowed by CORS. Must include credentials support for the
# session cookie to be sent at all.
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
