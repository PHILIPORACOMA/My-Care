# My Care - production environment for apps/api/.env (docs/DEPLOYMENT.md).
#
# Copy to /var/www/mycare/apps/api/.env, replace every CHANGE-ME, then run
# `php artisan key:generate`. The real file holds secrets: it is gitignored,
# owned by www-data, mode 640, and never copied off the server.
#
# Every line that differs from the development .env.example is marked (!).

APP_NAME="My Care"
APP_ENV=production                                  # (!)
APP_KEY=                                            # (!) filled by key:generate
APP_DEBUG=false                                     # (!) true leaks stack traces and config
APP_URL=https://CHANGE-ME.example.org               # (!)

# UTC in storage, always. Asia/Manila is applied at display time only
# (CLAUDE.md rule 6). Do not change this to Asia/Manila.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily                                   # (!) one file per day
LOG_DAILY_DAYS=30
LOG_LEVEL=warning                                   # (!)
LOG_DEPRECATIONS_CHANNEL=null

# MySQL 8. A dedicated user with rights on `mycare` only - never root
# (DEPLOYMENT.md step 3).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mycare
DB_USERNAME=mycare                                  # (!)
DB_PASSWORD=CHANGE-ME                               # (!)

# File drivers keep the schema to the 20 Data Dictionary entities (ADR-0004).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# One host serves everything (Phase 9), so the cookie belongs to that host
# alone and needs no parent domain.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true                          # (!) cookie only over HTTPS

# The host name, no scheme: staff login only works from an origin listed here.
SANCTUM_STATEFUL_DOMAINS=CHANGE-ME.example.org      # (!)
FRONTEND_URL=https://CHANGE-ME.example.org          # (!)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@CHANGE-ME.example.org"
MAIL_FROM_NAME="${APP_NAME}"

# Engine replay (ADR-0007). The defaults find `node` on PATH (set by the
# PHP-FPM pool) and the script built by deploy.sh; override only if Node lives
# somewhere unusual.
# MYCARE_NODE_BINARY=/usr/bin/node
# MYCARE_REPLAY_SCRIPT=/var/www/mycare/packages/engine-replay/dist/replay.mjs

# Shown on the System Dashboard (Figure 37). deploy.sh writes the commit here.
MYCARE_VERSION=dev
